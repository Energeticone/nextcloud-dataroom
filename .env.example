# Copy to .env. Passwords: letters and digits only (openssl rand -hex 24).
# A dollar sign or a quote will break Compose or Redis.

DOMAIN=files.example.com
ACME_EMAIL=you@example.com

ADMIN_USER=room-admin
ADMIN_PASSWORD=replace-with-48-hex-chars

DB_PASSWORD=replace-with-48-hex-chars
DB_ROOT_PASSWORD=replace-with-48-hex-chars
REDIS_PASSWORD=replace-with-48-hex-chars

GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-48-hex-chars

# Phone-number normalisation inside Nextcloud. AE or CA.
DEFAULT_PHONE_REGION=AE
